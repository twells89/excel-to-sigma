{
 "approvers": [],
 "buttons": [
  {
   "actions": [
    {
     "effects": [
      {
       "effect": "update-rows",
       "tableElementId": "parameters",
       "values": {
        "pa_start": {
         "formula": "DateAdd(\"month\", 1, Max([Parameters/Forecast Start Month]))",
         "type": "formula"
        }
       },
       "whichRows": {
        "formula": "true",
        "type": "formula"
       }
      }
     ],
     "id": "a-roll-forward",
     "trigger": "on-click"
    }
   ],
   "appearance": "filled",
   "id": "btnRoll",
   "kind": "button",
   "text": "Roll forward one month"
  },
  {
   "actions": [
    {
     "effects": [
      {
       "effect": "insert-rows",
       "tableElementId": "versions",
       "values": {
        "ve_at": {
         "formula": "Now()",
         "type": "formula"
        },
        "ve_by": {
         "formula": "CurrentUserEmail()",
         "type": "formula"
        },
        "ve_ebitda": {
         "formula": "Sum([PnL Combined/EBITDA])",
         "type": "formula"
        },
        "ve_gm": {
         "formula": "Sum([PnL Combined/GM])",
         "type": "formula"
        },
        "ve_rev": {
         "formula": "Sum([PnL Combined/Amount])",
         "type": "formula"
        },
        "ve_scn": {
         "control": "Scenario",
         "type": "control"
        },
        "ve_seq": {
         "formula": "Coalesce(Max([Versions/Log Order]), 0) + 1",
         "type": "formula"
        },
        "ve_start": {
         "formula": "Max([Parameters/Forecast Start Month])",
         "type": "formula"
        },
        "ve_ver": {
         "formula": "Concat(\"v\", Text(Int(Coalesce(Max([Versions/Log Order]), 0) + 1)))",
         "type": "formula"
        }
       }
      }
     ],
     "id": "a-snapshot-version",
     "trigger": "on-click"
    }
   ],
   "appearance": "filled",
   "id": "btnSnapshot",
   "kind": "button",
   "text": "Snapshot version"
  },
  {
   "actions": [
    {
     "effects": [
      {
       "effect": "insert-rows",
       "tableElementId": "approvals",
       "values": {
        "ap_at": {
         "formula": "Now()",
         "type": "formula"
        },
        "ap_by": {
         "formula": "CurrentUserEmail()",
         "type": "formula"
        },
        "ap_req": {
         "type": "constant",
         "value": {
          "type": "text",
          "value": "FY27 forecast"
         }
        },
        "ap_seq": {
         "formula": "Coalesce(Max([Approvals/Log Order]), 0) + 1",
         "type": "formula"
        },
        "ap_status": {
         "type": "constant",
         "value": {
          "type": "text",
          "value": "Submitted"
         }
        },
        "ap_to": {
         "type": "constant",
         "value": {
          "type": "text",
          "value": "Approver"
         }
        }
       }
      }
     ],
     "id": "a-submit-approval",
     "trigger": "on-click"
    }
   ],
   "appearance": "outline",
   "id": "btnSubmit",
   "kind": "button",
   "text": "Submit for approval"
  }
 ],
